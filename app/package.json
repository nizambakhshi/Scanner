{
  "name": "angel-bullish-scanner-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Operator dashboard and read API for the Angel One intraday bullish scanner (watchlist, signals, delivery health)",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:staging": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -p 3000",
    "start:staging": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "which-db": "node --import tsx scripts/which-db.mjs",
    "reset-password": "node --import tsx scripts/reset-password.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
