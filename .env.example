# Angel One SmartAPI Intraday Bullish Scanner — environment template.
#
# Copy to `.env` and fill in real values yourself. NEVER commit `.env`.
#   cp .env.example .env
#
# Only the variables your deployment actually needs must be set; the worker
# validates required ones at startup and fails with a clear, non-sensitive
# message naming the missing keys.

# ── Runtime mode ───────────────────────────────────────────────────────────
# live      = connect to Angel One SmartAPI (requires the ANGEL_* block)
# simulation= replay synthetic ticks, no broker access, no real alerts
SCAN_MODE=live

# Mark every generated record as simulated. Must stay `true` in simulation and
# `false` in live; the worker refuses to start if SCAN_MODE and this disagree.
SIMULATION_LABEL=true

# ── Application / deployment ───────────────────────────────────────────────
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@db.PROJECT.ref.supabase.co:5432/postgres?sslmode=require
TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
LOG_FORMAT=console            # console | json (use json in production)
WORKER_ID=worker-local
WORKER_HEARTBEAT_SECONDS=20
SESSION_LEASE_SECONDS=300     # distributed lease TTL for multi-replica safety

# ── Authentication (dashboard) ─────────────────────────────────────────────
# Generate a hash:  npm --prefix app run hash-password -- "your-password"
AUTH_ADMIN_EMAIL=admin@example.local
AUTH_ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=          # 32+ random bytes: openssl rand -hex 32
AUTH_SESSION_HOURS=12

# ── Angel One SmartAPI (server-side only; never exposed to the browser) ────
# Create at https://smartapi.angelbroking.com -> My Apps.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Optional: pre-issued refresh token. When present the worker renews the JWT
# instead of doing a TOTP login (TOTP logins are rate-limited by the exchange).
ANGEL_REFRESH_TOKEN=
# REST base URL. apiconnect.angelone.in is the current documented host.
ANGEL_BASE_URL=https://apiconnect.angelone.in
ANGEL_WS_URL=wss://smartapisocket.angelone.in/smart-stream
# WebSocket feed mode: 2 = QUOTE (ltp + day volume + day OHLC, smallest
# payload), 3 = SNAP_QUOTE (adds best-5 book). Both are tick feeds; the worker
# builds 1-minute candles itself.
ANGEL_FEED_MODE=2
# Integer price fields in the feed arrive scaled. 100 => value/100.
ANGEL_PRICE_SCALE=100
ANGEL_MAX_TOKENS_PER_MESSAGE=250
ANGEL_MAX_TOKENS_PER_SESSION=1000
ANGEL_REAUTH_MINUTES=210
INSTRUMENT_MASTER_URL=https://margincalculator.angelone.in/OpenAPI_File/files/OpenAPIScripMaster.json
HISTORICAL_WARMUP_DAYS=5

# ── Telegram notifications (server-side only) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_RETRY_BASE_SECONDS=10

# ── Scanner defaults (also editable per-config in the DB/UI) ───────────────
UNIVERSE=NIFTY500
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=20
VOLUME_LOOKBACK=20
RELATIVE_VOLUME_THRESHOLD=1.5
ALERT_COOLDOWN_MINUTES=15
REMOVAL_CONFIRM_CANDLES=3
FEED_STALENESS_SECONDS=90
CANDLE_GRACE_SECONDS=3
INITIAL_SCAN_CANDLES=5
MAX_SUBSCRIBED_INSTRUMENTS=500

# Ranking weights (must sum to 1.0; validated at startup)
RANK_WEIGHT_PRICE_STRENGTH=0.30
RANK_WEIGHT_RELATIVE_VOLUME=0.30
RANK_WEIGHT_VWAP_STRENGTH=0.20
RANK_WEIGHT_EMA_SPREAD=0.20

# ── Simulation knobs (ignored when SCAN_MODE=live) ─────────────────────────
SIMULATION_REPLAY_SPEED=60     # simulated seconds per real second
SIMULATION_SYMBOLS=25
SIMULATION_SEED=42
