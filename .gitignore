# ── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Secrets: never commit real environment files ───────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python worker ──────────────────────────────────────────────────────────
worker/.venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
worker/logs/
logs/
*.sqlite
coverage.xml
htmlcov/
.worker_state/

# ── Node / Next.js app ─────────────────────────────────────────────────────
node_modules/
app/.next/
app/out/
app/next-env.d.ts
*.tsbuildinfo

# ── Local data caches (instrument master downloads) ────────────────────────
data/cache/
*.tmp

# ── Generated local state (never commit) ───────────────────────────────────
# Supabase CLI writes a version marker here on every command.
supabase/.temp/
# The real edge gate lives under /opt/homebrew/etc/pgbouncer; these are only
# leftovers from running install_edge.sh on a dev machine.
ops/db-edge/certs/
ops/db-edge/*.local

# ── graphify knowledge graph (local analysis artifact) ─────────────────────
graphify-out/
